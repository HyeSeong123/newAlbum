{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "감자싹",
  "version": "0.9.1",
  "identifier": "com.oraedameun.album",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "감자싹",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* http://localhost:* data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/imported-media-v1/**",
            "$APPCACHE/thumbnails-v1/**",
            "$APPCACHE/pet-thumbnails-v1/**",
            "$APPCACHE/pet-thumbnails-sha256-v1/**"
          ],
          "deny": [
            "$APPDATA/album.sqlite*"
          ]
        }
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* http://localhost:* data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true,
        "template": "windows/installer.nsi",
        "installerHooks": "windows/branding-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "mainBinaryName": "gamjassak"
}
