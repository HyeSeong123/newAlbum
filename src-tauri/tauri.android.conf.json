{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "감자싹",
        "create": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/imported-media-v1/**",
            "$APPCACHE/thumbnails-v1/**",
            "$APPCACHE/pet-thumbnails-v1/**",
            "$APPCACHE/pet-thumbnails-sha256-v1/**"
          ],
          "deny": [
            "$APPDATA/album.sqlite*"
          ]
        }
      }
    }
  },
  "bundle": {
    "targets": "all",
    "android": {
      "minSdkVersion": 28
    }
  }
}
